NETBOX_IMAGE=netboxcommunity/netbox:v4.7.2-5.1.1
NETBOX_DB_IMAGE=postgres:17.11-alpine
NETBOX_REDIS_IMAGE=valkey/valkey:9.0.6-alpine
NETBOX_BIND=127.0.0.1
NETBOX_PORT=8000
NETBOX_DB_PASSWORD=change-me
NETBOX_REDIS_PASSWORD=change-me
# At least 50 characters: openssl rand -base64 48
NETBOX_SECRET_KEY=change-me-change-me-change-me-change-me-change-me-change-me
# At least 50 characters: openssl rand -base64 48
NETBOX_API_TOKEN_PEPPER=change-me-pepper-change-me-pepper-change-me-pepper-change-me
NETBOX_ADMIN_USER=admin
NETBOX_ADMIN_EMAIL=admin@umbrella.lab
NETBOX_ADMIN_PASSWORD=change-me
# API token for Umbrella, created with the admin on first start. Umbrella uses nbt_<key>.<token>.
# Key: 12 letters or digits (openssl rand -hex 6). Token: 40 letters or digits (openssl rand -hex 20).
NETBOX_API_KEY=0123456789ab
NETBOX_API_TOKEN=0123456789abcdef0123456789abcdef01234567
TZ=UTC
