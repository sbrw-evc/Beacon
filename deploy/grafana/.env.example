GRAFANA_IMAGE=grafana/grafana:13.2.3
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Ingest address and bearer token of the Umbrella connector built from the Grafana Alerting preset.
UMBRELLA_INGEST_URL=http://umbrella:8080/api/ingest/grafana
UMBRELLA_INGEST_TOKEN=change-me
# Umbrella Flow ClickHouse (the "CI traffic" dashboard): host of its HTTP interface (port 8123),
# a read-only user, its password and the database. See README.md "Umbrella Flow: CI traffic".
FLOW_CLICKHOUSE_HOST=flow-clickhouse
FLOW_CLICKHOUSE_USER=flow
FLOW_CLICKHOUSE_PASSWORD=
FLOW_CLICKHOUSE_DATABASE=flow
# Plugins installed on start; empty disables the download (install grafana-clickhouse-datasource yourself).
GRAFANA_PLUGINS=grafana-clickhouse-datasource
TZ=UTC
