ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:alpine-7.0.31
ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:alpine-7.0.31
ZABBIX_AGENT_IMAGE=zabbix/zabbix-agent2:alpine-7.0.31
# Zabbix 8.0: images with the alpine-8.0 tags, or alpine-trunk until those are published.
# ZABBIX_SERVER_IMAGE=zabbix/zabbix-server-pgsql:alpine-trunk
# ZABBIX_WEB_IMAGE=zabbix/zabbix-web-nginx-pgsql:alpine-trunk
# ZABBIX_AGENT_IMAGE=zabbix/zabbix-agent2:alpine-trunk
ZABBIX_DB_IMAGE=postgres:17.11-alpine
ZABBIX_DB_PASSWORD=change-me
ZABBIX_BIND=127.0.0.1
ZABBIX_WEB_PORT=8081
ZABBIX_TRAPPER_PORT=10051
ZABBIX_AGENT_HOSTNAME=zabbix-agent
TZ=UTC
