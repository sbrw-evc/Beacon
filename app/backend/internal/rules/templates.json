[
  {
    "method": "use",
    "signal": "use.cpu.utilization",
    "name": "CPU utilization",
    "query": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
    "ci_label": "instance",
    "op": ">",
    "threshold": 90,
    "for": "5m",
    "interval": "30s",
    "severity": "warning",
    "title": "CPU ${ci}: ${value}% (threshold ${threshold}%)",
    "enabled": true
  },
  {
    "method": "use",
    "signal": "use.mem.utilization",
    "name": "Memory utilization",
    "query": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
    "ci_label": "instance",
    "op": ">",
    "threshold": 90,
    "for": "5m",
    "interval": "30s",
    "severity": "warning",
    "title": "Memory ${ci}: ${value}% used",
    "enabled": true
  },
  {
    "method": "use",
    "signal": "use.disk.utilization",
    "name": "Disk space",
    "query": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
    "ci_label": "instance",
    "op": ">",
    "threshold": 85,
    "for": "5m",
    "interval": "30s",
    "severity": "error",
    "title": "Disk ${labels.mountpoint} on ${ci}: ${value}%",
    "enabled": true
  },
  {
    "method": "use",
    "signal": "use.cpu.saturation",
    "name": "CPU saturation (load per core)",
    "query": "node_load5 / on (instance) count by (instance) (node_cpu_seconds_total{mode=\"idle\"})",
    "ci_label": "instance",
    "op": ">",
    "threshold": 2,
    "for": "10m",
    "interval": "30s",
    "severity": "error",
    "title": "Load per core ${ci}: ${value}",
    "enabled": true
  },
  {
    "method": "use",
    "signal": "use.net.errors",
    "name": "Network errors",
    "query": "sum by (instance) (increase(node_network_receive_errs_total[5m]) + increase(node_network_transmit_errs_total[5m]))",
    "ci_label": "instance",
    "op": ">",
    "threshold": 0,
    "for": "0s",
    "interval": "30s",
    "severity": "warning",
    "title": "Network errors on ${ci}: ${value} in 5 min",
    "enabled": true
  },
  {
    "method": "use",
    "signal": "use.container.cpu",
    "name": "Container CPU",
    "query": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]))",
    "ci_label": "name",
    "op": ">",
    "threshold": 80,
    "for": "5m",
    "interval": "30s",
    "severity": "warning",
    "title": "CPU of container ${ci}: ${value}%",
    "enabled": true
  },
  {
    "method": "red",
    "signal": "red.rate",
    "name": "No requests",
    "query": "sum by (job) (rate(http_requests_total[5m]))",
    "ci_label": "job",
    "op": "<",
    "threshold": 0.1,
    "for": "10m",
    "interval": "30s",
    "severity": "error",
    "title": "Requests to ${ci}: ${value}/s",
    "enabled": true
  },
  {
    "method": "red",
    "signal": "red.errors",
    "name": "5xx error ratio",
    "query": "100 * sum by (job) (rate(http_requests_total{code=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_total[5m]))",
    "ci_label": "job",
    "op": ">",
    "threshold": 5,
    "for": "5m",
    "interval": "30s",
    "severity": "critical",
    "title": "5xx errors ${ci}: ${value}%",
    "enabled": true
  },
  {
    "method": "red",
    "signal": "red.duration",
    "name": "p99 latency",
    "query": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
    "ci_label": "job",
    "op": ">",
    "threshold": 1,
    "for": "5m",
    "interval": "30s",
    "severity": "error",
    "title": "p99 of ${ci}: ${value} s",
    "enabled": true
  }
]
